<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContentFactory.Core\ContentFactory.Core.csproj" />
    <ProjectReference Include="..\ContentFactory.Contracts\ContentFactory.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\media\prompts\script-planner.v1.txt"
                      Link="Providers\LmStudio\script-planner.v1.txt"
                      LogicalName="ContentFactory.Infrastructure.Providers.LmStudio.script-planner.v1.txt" />
    <EmbeddedResource Include="..\..\media\schemas\script-document.v1.schema.json"
                      Link="Providers\LmStudio\script-document.v1.schema.json"
                      LogicalName="ContentFactory.Infrastructure.Providers.LmStudio.script-document.v1.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
